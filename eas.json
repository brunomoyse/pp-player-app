{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_GRAPHQL_ENDPOINT": "http://localhost:8080/graphql",
        "EXPO_PUBLIC_GRAPHQL_WS_ENDPOINT": "ws://localhost:8080/graphql",
        "EXPO_PUBLIC_AUTH_BASE_URL": "http://localhost:8080"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_GRAPHQL_ENDPOINT": "https://pocketpair.be/api/graphql",
        "EXPO_PUBLIC_GRAPHQL_WS_ENDPOINT": "wss://pocketpair.be/api/graphql",
        "EXPO_PUBLIC_AUTH_BASE_URL": "https://pocketpair.be/api"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
