{
  "expo": {
    "name": "PocketPair",
    "slug": "pp-player-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pocketpair",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#18181a",
    "ios": {
      "bundleIdentifier": "com.pocketpair.app",
      "supportsTablet": true,
      "icon": "./assets/PocketPair.icon"
    },
    "android": {
      "package": "com.pocketpair.app",
      "adaptiveIcon": {
        "backgroundColor": "#18181a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181a",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "PocketPair uses Face ID to unlock your saved sign-in so you don't have to re-enter your password."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PocketPair uses the camera to scan tournament check-in QR codes."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#fee78a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
