{
  "expo": {
    "name": "PocketPair",
    "slug": "pp-player-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pocketpair",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#18181a",
    "ios": {
      "bundleIdentifier": "com.pocketpair.app",
      "supportsTablet": false,
      "icon": "./assets/PocketPair.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "fr",
          "nl"
        ]
      }
    },
    "android": {
      "package": "com.pocketpair.app",
      "adaptiveIcon": {
        "backgroundColor": "#18181a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#18181a",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-localization",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "PocketPair uses Face ID to unlock your saved sign-in so you don't have to re-enter your password."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PocketPair uses the camera to scan tournament check-in QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#fee78a"
        }
      ],
      "expo-image",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "nuagemagiquedev",
          "project": "pp-player-app"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "310027cb-3cb7-46fd-bae4-7d1d745e4077"
      }
    },
    "owner": "brunomoyse"
  }
}
