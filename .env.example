# PocketPair mobile (RN/Expo) — public runtime config.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.
#
# iOS simulator can reach the host via localhost. A physical device must use
# your machine's LAN IP (e.g. http://192.168.1.20:8080) — localhost won't resolve.

EXPO_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8080/graphql
EXPO_PUBLIC_GRAPHQL_WS_ENDPOINT=ws://localhost:8080/graphql
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:8080
