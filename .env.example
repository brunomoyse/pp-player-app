# PocketPair mobile (RN/Expo) — public runtime config.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build/start time.
#
# ── Which file is used when ────────────────────────────────────────────────
# Expo loads, highest precedence first:
#   .env.<mode>.local  >  .env.local  >  .env.<mode>  >  .env
# where <mode> = development for `expo start`, production for `expo export` / EAS build.
#
#   .env                        committed   → DEFAULT for every build (device installs,
#                                             EAS, local release) + the in-code fallback.
#                                             Points at the TEST server.
#   .env.development.local      gitignored  → LOCAL DEV ONLY (`expo start`). Points at
#                                             localhost. Never loaded by a build (wrong
#                                             mode) and never uploaded to EAS (gitignored),
#                                             so it cannot leak into a device build.
#
# Do NOT put endpoint vars in .env.local — it loads in production too and would
# override .env, sending a device build at localhost. Use .env.development.local.
#
# EAS cloud builds take their env from the matching profile in eas.json
# (development=localhost, preview/production=test), which is authoritative there.
#
# Physical device in dev: localhost won't resolve — use your LAN IP
# (e.g. http://192.168.1.20:8080) in .env.development.local.
# ───────────────────────────────────────────────────────────────────────────

# Copy these into .env.development.local for local development:
EXPO_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:8080/graphql
EXPO_PUBLIC_GRAPHQL_WS_ENDPOINT=ws://localhost:8080/graphql
EXPO_PUBLIC_AUTH_BASE_URL=http://localhost:8080

# Achievement-video render service (pp-video)
EXPO_PUBLIC_RENDER_BASE_URL=http://localhost:4000
